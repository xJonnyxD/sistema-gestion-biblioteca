@{
    ViewData["Title"] = "Acerca de";
}

<article class="acerca">
    <header class="acerca-portada">
        <h1>Biblioteca Virtual</h1>
        <p>Un espacio digital para acercar los libros a toda la comunidad.</p>
    </header>

    <section class="acerca-seccion">
        <h2>Quiénes somos</h2>
        <p>
            La <strong>Biblioteca Virtual</strong> es una plataforma dedicada a la gestión y
            consulta de un catálogo bibliográfico en línea. Nace como parte del módulo de
            <em>Programación Web II (Frontend)</em> con el propósito de ofrecer acceso a libros,
            autores y servicios bibliotecarios desde cualquier lugar y en cualquier momento.
        </p>
    </section>

    <section class="acerca-seccion">
        <h2>Nuestra colección</h2>
        <!-- Componente reutilizable .biblio-card distribuido con CSS Grid -->
        <div class="biblio-grid">
            <article class="biblio-card">
                <h3 class="biblio-card__title">Libros</h3>
                <p class="biblio-card__text">Un catálogo de obras clásicas y contemporáneas con información de disponibilidad.</p>
            </article>
            <article class="biblio-card">
                <h3 class="biblio-card__title">Autores</h3>
                <p class="biblio-card__text">Fichas de los autores registrados, con su nacionalidad y trayectoria.</p>
            </article>
            <article class="biblio-card">
                <h3 class="biblio-card__title">Categorías</h3>
                <p class="biblio-card__text">Clasificación temática que facilita la búsqueda dentro del catálogo.</p>
            </article>
        </div>
    </section>

    <section class="acerca-seccion">
        <h2>Servicios bibliotecarios</h2>
        <!-- Componente reutilizable .biblio-feature distribuido con Flexbox -->
        <div class="biblio-flex">
            <div class="biblio-feature">
                <span class="biblio-feature__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </span>
                <div>
                    <h3 class="biblio-feature__title">Préstamo de libros</h3>
                    <p class="biblio-feature__text">Solicitud de ejemplares y control de devoluciones.</p>
                </div>
            </div>
            <div class="biblio-feature">
                <span class="biblio-feature__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </span>
                <div>
                    <h3 class="biblio-feature__title">Consulta en línea</h3>
                    <p class="biblio-feature__text">Búsqueda por título, autor o categoría.</p>
                </div>
            </div>
            <div class="biblio-feature">
                <span class="biblio-feature__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <div>
                    <h3 class="biblio-feature__title">Gestión de usuarios</h3>
                    <p class="biblio-feature__text">Registro de lectores habilitados para préstamos.</p>
                </div>
            </div>
            <div class="biblio-feature">
                <span class="biblio-feature__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </span>
                <div>
                    <h3 class="biblio-feature__title">Acceso permanente</h3>
                    <p class="biblio-feature__text">Disponible las 24 horas, todos los días.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="acerca-seccion">
        <h2>Misión</h2>
        <blockquote class="acerca-cita">
            Promover la lectura y el acceso al conocimiento mediante una plataforma sencilla,
            ordenada y disponible para toda la comunidad.
        </blockquote>
    </section>

    <footer class="acerca-contacto">
        <h2>Contacto</h2>
        <address>
            Biblioteca Virtual<br />
            Correo: <a href="mailto:contacto@biblioteca.edu.sv">contacto@biblioteca.edu.sv</a><br />
            Horario de atención en línea: 24 horas
        </address>
    </footer>
</article>
