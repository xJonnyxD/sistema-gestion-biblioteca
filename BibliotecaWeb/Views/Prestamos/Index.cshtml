@model IEnumerable<Prestamo>
@{
    ViewData["Title"] = "Préstamos";
}

<h1 class="mb-3">Préstamos</h1>
<p class="text-muted">Módulo para registrar y controlar los préstamos de libros.</p>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No hay préstamos registrados.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Libro</th>
                <th>Usuario</th>
                <th>Fecha de préstamo</th>
                <th>Fecha de devolución</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prestamo in Model)
            {
                <tr>
                    <td>@prestamo.Id</td>
                    <td>@prestamo.Libro</td>
                    <td>@prestamo.Usuario</td>
                    <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                    <td>@prestamo.FechaDevolucion.ToString("dd/MM/yyyy")</td>
                    <td>
                        @switch (prestamo.Estado)
                        {
                            case EstadoPrestamo.Devuelto:
                                <span class="badge bg-success">Devuelto</span>
                                break;
                            case EstadoPrestamo.Pendiente:
                                <span class="badge bg-warning text-dark">Pendiente</span>
                                break;
                            case EstadoPrestamo.Atrasado:
                                <span class="badge bg-danger">Atrasado</span>
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
