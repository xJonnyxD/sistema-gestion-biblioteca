@model IEnumerable<Autor>
@{
    ViewData["Title"] = "Autores";
}

<h1 class="mb-3">Autores</h1>
<p class="text-muted">Módulo para administrar los autores registrados en la biblioteca.</p>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No hay autores registrados.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Nacionalidad</th>
                <th>Fecha de nacimiento</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var autor in Model)
            {
                <tr>
                    <td>@autor.Id</td>
                    <td>@autor.Nombre</td>
                    <td>@autor.Apellido</td>
                    <td>@autor.Nacionalidad</td>
                    <td>@autor.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (autor.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Detalle" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-secondary">Detalle</a>
                        <a asp-action="Editar" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
