@model Categoria
@{
    ViewData["Title"] = Model.Nombre;
}

<h1 class="mb-3">Detalle de la categoría</h1>

<div class="row">
    <div class="col-md-8">
        <h2>@Model.Nombre</h2>

        <dl class="row">
            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">@Model.Descripcion</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.Activa)
                {
                    <span class="badge bg-success">Activa</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactiva</span>
                }
            </dd>
        </dl>

        <div class="d-flex flex-wrap gap-2 mt-2">
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                <a asp-action="Eliminar" asp-route-id="@Model.Id" class="btn btn-outline-danger">Eliminar</a>
            }
            <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
        </div>
    </div>
</div>
