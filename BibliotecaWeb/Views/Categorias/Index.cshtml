@model IEnumerable<Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Categorías</h1>
        <p class="text-muted mb-0">Módulo para administrar las categorías con las que se clasifican los libros.</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary">Agregar categoría</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No hay categorías registradas.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Categoría</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Id</td>
                    <td>@categoria.Nombre</td>
                    <td>@categoria.Descripcion</td>
                    <td>
                        @if (categoria.Activa)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactiva</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
