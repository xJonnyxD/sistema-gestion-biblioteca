@model IEnumerable<Libro>
@{
    ViewData["Title"] = "Libros";
    var buscar = ViewData["Buscar"] as string;
    var total = Model.Count();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Libros</h1>
        <p class="text-muted mb-0">Catálogo de libros de la biblioteca.</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary">Agregar libro</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-center mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="buscar" value="@buscar" class="form-control"
               placeholder="Buscar por título, autor o categoría..." aria-label="Buscar libros" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(buscar))
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-link">Limpiar</a>
        </div>
    }
    <div class="col-12">
        <small class="text-muted">
            @if (string.IsNullOrWhiteSpace(buscar))
            {
                <text>@total libro(s) en el catálogo.</text>
            }
            else
            {
                <text>@total resultado(s) para «@buscar».</text>
            }
        </small>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        @if (string.IsNullOrWhiteSpace(buscar))
        {
            <text>No hay libros registrados en el catálogo.</text>
        }
        else
        {
            <text>No se encontraron libros que coincidan con «@buscar».</text>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var libro in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="~/images/@libro.ImagenNombre" class="card-img-top" alt="Portada de @libro.Titulo"
                         style="height: 220px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@libro.Titulo</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@libro.Autor</h6>
                        <p class="card-text mb-2">
                            <span class="badge bg-secondary">@libro.Categoria</span>
                            <span class="badge bg-light text-dark">@libro.AnioPublicacion</span>
                            @if (libro.HayDisponibles)
                            {
                                <span class="badge bg-success">@libro.Disponibles disponibles</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Sin existencia</span>
                            }
                        </p>
                        <div class="mt-auto d-flex gap-2">
                            <a asp-action="Detalle" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-secondary">Detalle</a>
                            <a asp-action="Editar" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Eliminar" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
