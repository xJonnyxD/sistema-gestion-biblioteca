@model IEnumerable<Libro>
@{
    ViewData["Title"] = "Libros";
}

<h1 class="mb-3">Libros</h1>
<p class="text-muted">Módulo para administrar el catálogo de libros de la biblioteca.</p>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No hay libros registrados en el catálogo.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Categoría</th>
                <th>Año</th>
                <th>Disponibilidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in Model)
            {
                <tr>
                    <td>@libro.Id</td>
                    <td>@libro.Titulo</td>
                    <td>@libro.Autor</td>
                    <td>@libro.Categoria</td>
                    <td>@libro.AnioPublicacion</td>
                    <td>
                        @if (libro.HayDisponibles)
                        {
                            <span class="badge bg-success">@libro.Disponibles disponibles</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Sin existencia</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
